ADMIN_PORT=8080
ADMIN_PUBLIC_URL=http://127.0.0.1:8080
ADMIN_COOKIE_SECURE=false
ADMIN_SESSION_HOURS=8
ADMIN_LOGIN_ATTEMPTS=5
ADMIN_LOGIN_WINDOW_SECONDS=900

TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_USER_PHONE=
